# ========================================
# WhatsApp Configuration — append to your existing .env
# ========================================

# Meta Cloud Business API
WHATSAPP_BUSINESS_ACCOUNT_ID=your_biz_account_id
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=random_verification_token_for_webhook
# Added vs. original spec: required to verify X-Hub-Signature-256 on every
# inbound webhook POST. Found in Meta App Dashboard > Settings > Basic.
WHATSAPP_APP_SECRET=your_meta_app_secret

# Message templates (must be pre-created + approved in Meta Business Manager)
WHATSAPP_TEMPLATE_ORDER_PLACED=order_placed
WHATSAPP_TEMPLATE_PAYMENT_CONFIRMED=payment_confirmed
WHATSAPP_TEMPLATE_SHIPMENT_CREATED=shipment_created
WHATSAPP_TEMPLATE_SHIPMENT_PICKED=shipment_picked
WHATSAPP_TEMPLATE_IN_TRANSIT=in_transit
WHATSAPP_TEMPLATE_OUT_FOR_DELIVERY=out_for_delivery
WHATSAPP_TEMPLATE_DELIVERED=delivered
WHATSAPP_TEMPLATE_DELIVERY_FAILED=delivery_failed
WHATSAPP_TEMPLATE_REFUND_INITIATED=refund_initiated
WHATSAPP_TEMPLATE_LANGUAGE=en

# ========================================
# Automation Engine Configuration
# ========================================
MESSAGE_QUEUE_PROCESSOR_INTERVAL_MS=60000
MESSAGE_QUEUE_BATCH_SIZE=10
MESSAGE_QUEUE_MAX_RETRIES=7

RETRY_DELAYS_MS=5000,15000,45000,120000,300000,900000,3600000

WHATSAPP_ENABLED=true
WHATSAPP_SEND_ORDER_PLACED=true
WHATSAPP_SEND_PAYMENT_CONFIRMED=true
WHATSAPP_SEND_SHIPMENT_CREATED=true
WHATSAPP_SEND_DELIVERY_UPDATES=true
WHATSAPP_SEND_REFUND_INITIATED=true

WHATSAPP_LOG_LEVEL=info
WHATSAPP_LOG_TO_CONSOLE=true
WHATSAPP_LOG_TO_DATABASE=true

# ========================================
# Module integration / infra
# ========================================
# Only needed if your repo doesn't already have a Supabase admin client —
# see src/lib/supabaseAdmin.ts. Use the SAME project as your existing
# Supabase instance, not a new one.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Bearer token for the admin endpoints (/api/whatsapp/admin/*, /api/whatsapp/send).
# Replace src/lib/adminAuth.ts with your real admin-auth check and remove this
# if you already have JWT-role-based admin auth elsewhere in the app.
ADMIN_API_TOKEN=generate_a_long_random_value

# Optional: protects the /api/cron/* routes with an extra shared secret on
# top of Vercel's built-in cron request restriction.
CRON_SECRET=generate_a_long_random_value
