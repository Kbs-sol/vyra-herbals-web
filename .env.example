# ============================================================================
# Vyra Herbals — environment template
# ============================================================================
# Copy to `.env` (gitignored) and fill in real values.
#
# Anything prefixed NEXT_PUBLIC_ is embedded in the browser bundle and is
# therefore PUBLIC. Never put a secret behind that prefix.
#
# The app no longer ships fallback values for secrets: if one of the required
# variables below is missing, the affected route fails loudly instead of
# quietly running on a default that is published in the source tree.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

SUPABASE_URL=https://your-project.supabase.co
# REQUIRED. Server-only, bypasses RLS. There is deliberately no anon-key
# fallback — a missing value must fail, not silently downgrade.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

SUPABASE_PUBLIC_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=products

# --- Admin panel ------------------------------------------------------------
ADMIN_EMAIL=admin@example.com

# Preferred: a scrypt digest, so the plaintext password exists nowhere.
# Generate with:
#   node -e "const{randomBytes,scryptSync}=require('crypto');const s=randomBytes(16);console.log('scrypt:'+s.toString('hex')+':'+scryptSync(process.argv[1],s,64).toString('hex'))" 'your-password'
ADMIN_PASSWORD_HASH=

# Fallback: plaintext, compared in constant time. Leave blank if you set the
# hash above. Set exactly one of these two.
ADMIN_PASSWORD=

# REQUIRED. Signs the admin session cookie. Must be >= 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this immediately invalidates every existing admin session.
JWT_SECRET=

# --- Application ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://vyraherbals.com

# --- Easebuzz payment gateway -----------------------------------------------
EASEBUZZ_KEY=
EASEBUZZ_SALT=
EASEBUZZ_ENV=test

# --- Shipping (iCarry) ------------------------------------------------------
ICARRY_USERNAME=
ICARRY_KEY=
ICARRY_PICKUP_ADDRESS_ID=
ICARRY_BOOK_ON_CREATE=true
ICARRY_PROXY_URL=
# Auto-assign tuning (all optional — defaults shown)
# ICARRY_SELECT_CHEAPEST=true          # false = use ICARRY_COURIER_PRIORITY order instead of cheapest-first
# ICARRY_COURIER_PRIORITY=Xpressbees,Delhivery,Amazon Shipping
# ICARRY_MAX_COURIER_ATTEMPTS=5        # couriers to try before saving Unassigned
# ICARRY_ORIGIN_PINCODE=504231         # must match the pickup address above

# --- OTP (Message Central) --------------------------------------------------
NEXT_PUBLIC_MESSAGE_CENTRAL_CUSTOMER_ID=
MESSAGE_CENTRAL_KEY=

# --- Scheduled jobs ---------------------------------------------------------
# REQUIRED for /api/cron/reconcile-payments. Vercel Cron sends this as
# `Authorization: Bearer <CRON_SECRET>`; without it the endpoint returns 401.
CRON_SECRET=

# --- Analytics --------------------------------------------------------------
# All four are safe to expose to the browser (they're identifiers, not secrets).
# Missing values silently skip that tool — a preview deploy without ad-pixel
# creds does not spray broken tags into the DOM.

# Google Analytics 4 property ID — "G-XXXXXXXXXX"
NEXT_PUBLIC_GA4_ID=G-K0F7N513MS

# Microsoft Clarity project ID — heatmaps + session replay
# https://clarity.microsoft.com/  →  Settings → Setup → ID
NEXT_PUBLIC_CLARITY_ID=

# Meta Pixel (the "organic / retargeting" pixel, primary events)
NEXT_PUBLIC_META_PIXEL_ID=

# Optional second Meta Pixel dedicated to Ads campaign performance.
# Only set if the marketing team wants separate reporting from organic events.
NEXT_PUBLIC_META_ADS_PIXEL_ID=

# Optional GTM container. Leave blank unless you specifically use GTM;
# AnalyticsLoader loads GA4/Clarity/Meta Pixel directly for speed.
NEXT_PUBLIC_GTM_ID=

# Optional Google Ads conversion ID for reporting purchases into Google Ads
# alongside GA4 (e.g. "AW-1234567890"). Leave blank if Google Ads is not run.
NEXT_PUBLIC_GADS_CONVERSION_ID=

# Optional Pinterest Tag ID. Hair-care / beauty audiences skew high on
# Pinterest; the tag fires PageView + basic events via AnalyticsLoader.
NEXT_PUBLIC_PINTEREST_TAG_ID=

# Legacy alias — kept for older imports. Point it to the same value as
# NEXT_PUBLIC_META_PIXEL_ID.
NEXT_PUBLIC_FB_PIXEL_ID=

# --- Meta Conversions API (server-side) -------------------------------------
# Meta Pixel is browser-side and loses 20-40% of events (iOS ITP, adblockers,
# CSP). CAPI runs server-side from src/utils/metaCapi.ts to plug the gap.
# Access token: Meta Business → Events Manager → your Pixel → Settings →
#   "Generate access token" (system user token recommended).
META_CAPI_ACCESS_TOKEN=
# Optional test event code (start with "TEST"), only for validating with the
# Events Manager Test Events tab. Remove for production.
META_CAPI_TEST_EVENT_CODE=
# Optional: pin the Graph API version. Defaults to v18.0.
META_CAPI_API_VERSION=v18.0

# Optional — if the "Ads pixel" (NEXT_PUBLIC_META_ADS_PIXEL_ID) sits under a
# DIFFERENT Meta Business account than the primary Pixel, provide its own
# access token here. Left blank, the primary token is reused.
META_ADS_CAPI_ACCESS_TOKEN=
# Server-side variant of the ads pixel ID. Only needed if the primary
# NEXT_PUBLIC_META_ADS_PIXEL_ID is not set on the server for some reason
# (e.g. edge/runtime env inconsistency). Prefer to set the NEXT_PUBLIC_ one.
META_ADS_PIXEL_ID=

# --- Site origin ------------------------------------------------------------
# Used by sitemap.ts, robots.ts, and every canonical URL. Also used by the
# blog route to build absolute URLs to /api/blogs. Falls back to
# https://vyraherbals.com if unset.
NEXT_PUBLIC_SITE_ORIGIN=https://vyraherbals.com

# --- Homepage hero video ----------------------------------------------------
# Bare YouTube video ID (11 chars after v=). Set once, remove the .mp4 from
# the repo. See docs/SYSTEM_LITERACY.md → "Media offload plan".
NEXT_PUBLIC_HOME_HERO_VIDEO_ID=

# --- WhatsApp Cloud API (Meta) ----------------------------------------------
# All server-side (no NEXT_PUBLIC_ prefix). See docs/WHATSAPP_GO_LIVE.md for
# full go-live walkthrough. Fresh values from Meta Business → App Dashboard
# → WhatsApp → API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Any random string; you invent it. Meta uses it to verify the webhook once.
WHATSAPP_VERIFY_TOKEN=
# From App Dashboard → App Settings → Basic → App Secret. Used to verify
# incoming webhook HMAC signatures.
WHATSAPP_APP_SECRET=
# When true, WhatsApp module is enabled (default). Set to "false" in preview
# environments to prevent accidental sends.
WHATSAPP_ENABLED=true

