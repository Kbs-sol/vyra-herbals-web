# ========================================
# VYRA HERBALS - ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control
# ========================================

# ===================
# SUPABASE CONFIG
# ===================
# Get these from your Supabase project settings > API

# Public URL (used by client-side code)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only variables (for API routes)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: Public URL for Supabase Storage
# Used by /api/uploads/[name] route for image redirection
SUPABASE_PUBLIC_URL=https://your-project-id.supabase.co
SUPABASE_STORAGE_BUCKET=public

# ===================
# PAYMENT CONFIG (OPTIONAL)
# ===================
# Easebuzz payment gateway (only needed for online payments)
# EASEBUZZ_KEY=your-merchant-key
# EASEBUZZ_SALT=your-salt
# EASEBUZZ_ACCESS_KEY=your-access-key

# ===================
# SHIPPING CONFIG (OPTIONAL)
# ===================
# Third-party shipping provider URL for tracking
# SHIPPING_PROXY_URL=https://your-shipping-provider.com/api/track

# ===================
# APP CONFIG
# ===================
# Base URL for production
# NEXT_PUBLIC_BASE_URL=https://vyraherbals.com
