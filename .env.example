# ============================================================================
# Vyra Herbals — environment template
# ============================================================================
# Copy to `.env` (gitignored) and fill in real values.
#
# Anything prefixed NEXT_PUBLIC_ is embedded in the browser bundle and is
# therefore PUBLIC. Never put a secret behind that prefix.
#
# The app no longer ships fallback values for secrets: if one of the required
# variables below is missing, the affected route fails loudly instead of
# quietly running on a default that is published in the source tree.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

SUPABASE_URL=https://your-project.supabase.co
# REQUIRED. Server-only, bypasses RLS. There is deliberately no anon-key
# fallback — a missing value must fail, not silently downgrade.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

SUPABASE_PUBLIC_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=products

# --- Admin panel ------------------------------------------------------------
ADMIN_EMAIL=admin@example.com

# Preferred: a scrypt digest, so the plaintext password exists nowhere.
# Generate with:
#   node -e "const{randomBytes,scryptSync}=require('crypto');const s=randomBytes(16);console.log('scrypt:'+s.toString('hex')+':'+scryptSync(process.argv[1],s,64).toString('hex'))" 'your-password'
ADMIN_PASSWORD_HASH=

# Fallback: plaintext, compared in constant time. Leave blank if you set the
# hash above. Set exactly one of these two.
ADMIN_PASSWORD=

# REQUIRED. Signs the admin session cookie. Must be >= 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this immediately invalidates every existing admin session.
JWT_SECRET=

# --- Application ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://vyraherbals.com

# --- Easebuzz payment gateway -----------------------------------------------
EASEBUZZ_KEY=
EASEBUZZ_SALT=
EASEBUZZ_ENV=test

# --- Shipping (iCarry) ------------------------------------------------------
ICARRY_USERNAME=
ICARRY_KEY=
ICARRY_PICKUP_ADDRESS_ID=
ICARRY_BOOK_ON_CREATE=true
ICARRY_PROXY_URL=

# --- OTP (Message Central) --------------------------------------------------
NEXT_PUBLIC_MESSAGE_CENTRAL_CUSTOMER_ID=
MESSAGE_CENTRAL_KEY=

# --- Scheduled jobs ---------------------------------------------------------
# REQUIRED for /api/cron/reconcile-payments. Vercel Cron sends this as
# `Authorization: Bearer <CRON_SECRET>`; without it the endpoint returns 401.
CRON_SECRET=

# --- Analytics --------------------------------------------------------------
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=
