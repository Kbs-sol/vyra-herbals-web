{
  "buildCommand": "npm run build",
  "regions": ["bom1"],
  "env": {
    "SKIP_TYPE_CHECK": "1"
  },
  "build": {
    "env": {
      "SKIP_STATIC_GENERATION": "1"
    }
  },
  "functions": {
    "app/api/shipping/track/route.ts": {
      "maxDuration": 30
    },
    "app/api/payment/cod/route.ts": {
      "maxDuration": 60
    },
    "app/api/payment/success/route.ts": {
      "maxDuration": 60
    },
    "app/api/payment/reconcile/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/reconcile-payments/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/scheduled-communications/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/process-message-queue",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/scheduled-communications",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/clean-old-logs",
      "schedule": "0 2 * * *"
    }
  ]
}
